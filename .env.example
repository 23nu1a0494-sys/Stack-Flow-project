# StockFlow SaaS Inventory Management System Environment Configuration

# Server & Security
PORT=3000
JWT_SECRET="stockflow-super-secret-jwt-key-2026"
NODE_ENV="development"

# PostgreSQL Database Configuration
# StockFlow is powered by PostgreSQL.
# If DATABASE_URL is provided, StockFlow connects directly to your external PostgreSQL server.
# If omitted or not configured, StockFlow automatically initializes and persists into an embedded
# PostgreSQL instance (via PGlite WASM) with 100% PostgreSQL SQL syntax, foreign keys, & ACID transactions.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow"

# Alternative standard PostgreSQL connection parameters (used if DATABASE_URL is not set):
# PGHOST="localhost"
# PGPORT="5432"
# PGUSER="postgres"
# PGPASSWORD="password"
# PGDATABASE="stockflow"

# Gemini AI API Key (Injected by AI Studio if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
